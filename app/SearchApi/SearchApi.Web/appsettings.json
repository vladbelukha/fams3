{
  "AllowedHosts": "*",
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Splunk" ],
    "MinimumLevel": "Debug",
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] {ServiceName} {Message:lj} {SearchRequestKey}{DataPartner}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "SearchApi"
    }
  },

  "DeepSearch": {
    "MaxWaveCount": 4
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "Username": "guest",
    "Password": "guest"
  },
  "Redis": {
    "Password": "",
    "AbortOnConnectFail": false,
    "SyncTimeout": 5000,
    "ConnectTimeout": 10000,
    "ConnectRetry": 4,
    "Hosts": [
      {
        "Host": "localhost",
        "Port": "6379"
      }
    ]
  },
  "auth": {
    "dynadapter": {
      "enabled": false,
      "tokenUrl": "https://keycloak:8080/auth/realms/fams/protocol/openid-connect/token",
      "clientId": "search-api",
      "clientSecret": "replace-me"
    }
  }
}
